NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/file_share
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
CLAMAV_ENABLED=false
CLAMAV_SCAN_COMMAND=clamdscan
LOG_LEVEL=debug
CLIENT_ORIGIN=http://localhost:5173
